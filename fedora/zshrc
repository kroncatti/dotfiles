# Fedora-specific zsh setup, sourced by shared/zsh/zshrc

export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"   # oh-my-posh, go install (asdf, kubectx, lazydocker)
export PNPM_HOME="$HOME/.local/share/pnpm"
ZSH_AUTOSUGGESTIONS="/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
OMP_CONFIG="$HOME/.config/oh-my-posh/easy-term.omp.json"
