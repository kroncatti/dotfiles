# macOS-specific zsh setup, sourced by shared/zsh/zshrc

export JAVA_HOME=$(/usr/libexec/java_home -v 17)
alias all_javas="/usr/libexec/java_home -V"

BREW_PREFIX="$(brew --prefix)"
export PNPM_HOME="$HOME/Library/pnpm"
NVM_SH="$BREW_PREFIX/opt/nvm/nvm.sh"
ZSH_AUTOSUGGESTIONS="$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
OMP_CONFIG="$BREW_PREFIX/opt/oh-my-posh/themes/easy-term.omp.json"
