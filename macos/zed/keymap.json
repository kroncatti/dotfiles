// Zed keymap for macOS. ~/.config/zed/keymap.json is a symlink to this file.
// Base keymap is JetBrains (set in shared/zed/settings.json); these are additions on top.
[
  {
    "context": "Editor",
    "bindings": {
      // Double-tap Cmd toggles inlay hints (types, implicits) on/off
      "cmd cmd": "editor::ToggleInlayHints"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      // Double-tap Shift opens the file finder, like IntelliJ's Search Everywhere
      "shift shift": "file_finder::Toggle"
    }
  },
  {
    // Clojure files only: Cursive's REPL and structural-editing keys, run as tasks from shared/zed/tasks.json
    "context": "Editor && mode == full && (extension == clj || extension == cljs || extension == cljc || extension == edn || extension == bb)",
    "bindings": {
      // REPL (start it first with the "clojure: start nREPL" task)
      "cmd-shift-p": ["task::Spawn", { "task_name": "clojure: eval top form" }],
      "cmd-shift-e": ["task::Spawn", { "task_name": "clojure: eval form before cursor" }],
      "cmd-shift-l": ["task::Spawn", { "task_name": "clojure: load file in REPL" }],
      // Paredit
      "cmd-shift-k": ["task::Spawn", { "task_name": "clojure: slurp forward" }],
      "cmd-shift-j": ["task::Spawn", { "task_name": "clojure: barf forward" }],
      "ctrl-cmd-j": ["task::Spawn", { "task_name": "clojure: slurp backward" }],
      "ctrl-cmd-k": ["task::Spawn", { "task_name": "clojure: barf backward" }],
      "ctrl-cmd-r": ["task::Spawn", { "task_name": "clojure: raise" }],
      "ctrl-cmd-s": ["task::Spawn", { "task_name": "clojure: splice" }]
    }
  }
]
