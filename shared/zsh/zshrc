# Shared zsh config for every machine. ~/.zshrc is a symlink to this file.
# OS-specific setup lives in <os>/zshrc; machine-specific or secret stuff goes in ~/.zshrc.local (never committed).

# Resolve the repo root through the ~/.zshrc symlink
DOTFILES="${${(%):-%x}:A:h:h:h}"
case "$(uname -s)" in
  Darwin) DOTFILES_OS=macos ;;
  Linux)  DOTFILES_OS=fedora ;;
esac

# Sets PATH, PNPM_HOME, ZSH_AUTOSUGGESTIONS, OMP_CONFIG
[ -f "$DOTFILES/$DOTFILES_OS/zshrc" ] && source "$DOTFILES/$DOTFILES_OS/zshrc"

alias nrepl='clj -M:nREPL -m nrepl.cmdline'

alias python=python3
alias pip=pip3

# Git stuff
alias gs='git status'
alias gc='git commit -m'
alias ga='git add'
alias gaa='git add .'
alias gp='git push origin $(git rev-parse --abbrev-ref HEAD)'

# k8s stuff
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# Docker stuff
alias lzd='lazydocker'

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000000
SAVEHIST=100000000
setopt appendhistory
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY

[ -f "$ZSH_AUTOSUGGESTIONS" ] && source "$ZSH_AUTOSUGGESTIONS"

command -v fzf >/dev/null && source <(fzf --zsh)

# asdf: Node.js and Java versions, pinned in ~/.tool-versions -> shared/asdf/tool-versions
export ASDF_DATA_DIR="$HOME/asdf/data"
export PATH="$ASDF_DATA_DIR/shims:$PATH"
fpath=("$ASDF_DATA_DIR/completions" $fpath)
# JAVA_HOME follows the asdf java version (global or per-project .tool-versions)
[ -f "$ASDF_DATA_DIR/plugins/java/set-java-home.zsh" ] && source "$ASDF_DATA_DIR/plugins/java/set-java-home.zsh"
alias all_javas='asdf list java'

# pnpm
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

autoload -Uz compinit && compinit

command -v oh-my-posh >/dev/null && eval "$(oh-my-posh init zsh --config "$OMP_CONFIG")"
